# ─── Database (Neon Postgres) ───────────────────────────────────────────────
# Neon dashboard -> Connection string. Must include ?sslmode=require
#
# LOCAL DEV: use the DIRECT (unpooled) string — the host WITHOUT "-pooler".
#   Payload creates and alters the schema on boot, and Neon's pooler runs
#   pgBouncer in transaction mode, which breaks some of that DDL.
# PRODUCTION on Vercel: use the POOLED string (host WITH "-pooler"), so
#   serverless functions do not exhaust Postgres connections.
DATABASE_URL=

# ─── Payload ───────────────────────────────────────────────────────────────
# Signs auth tokens and preview URLs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out.
PAYLOAD_SECRET=

# ─── Media storage (Vercel Blob) ───────────────────────────────────────────
# Vercel -> Storage -> Blob -> connect to the project. Optional in local dev:
# with no token, uploads fall back to the local filesystem.
BLOB_READ_WRITE_TOKEN=

# ─── GitHub (brief section 8) ──────────────────────────────────────────────
# Fine-grained PAT, public-repo read only. Server-side only, never exposed.
GITHUB_TOKEN=

# ─── Email alerts (Resend) ─────────────────────────────────────────────────
# resend.com -> API keys. Without a key the forms still save to the admin;
# only the alert email is skipped (and logged).
RESEND_API_KEY=
# Where inquiry and application alerts go. Comma-separate several.
ALERT_EMAIL_TO=renoacollective@gmail.com
# Resend only sends from a verified domain. Until one is verified, leave this
# empty and alerts come from Resend's own onboarding@resend.dev sender.
ALERT_EMAIL_FROM=

# ─── Spam protection (Cloudflare Turnstile) ────────────────────────────────
# Both keys, or neither. With neither, the forms fall back to the honeypot,
# the timing check and the per-IP rate limit in src/lib/spam.ts.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Booking (Cal.com) ─────────────────────────────────────────────────────
# A handle ("renoa/intro") or a full cal.com URL. The Navigation global's
# "Book a call" link wins over this when it already points at Cal.com, so the
# team can change it in the admin without a deploy.
NEXT_PUBLIC_CAL_LINK=
