# ─── Database (Neon Postgres) ───────────────────────────────────────────────
# Neon dashboard -> Connection string. Must include ?sslmode=require
#
# LOCAL DEV: use the DIRECT (unpooled) string — the host WITHOUT "-pooler".
#   Payload creates and alters the schema on boot, and Neon's pooler runs
#   pgBouncer in transaction mode, which breaks some of that DDL.
# PRODUCTION on Vercel: use the POOLED string (host WITH "-pooler"), so
#   serverless functions do not exhaust Postgres connections.
DATABASE_URL=

# ─── Payload ───────────────────────────────────────────────────────────────
# Signs auth tokens and preview URLs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out.
PAYLOAD_SECRET=

# ─── Media storage (Vercel Blob) ───────────────────────────────────────────
# Vercel -> Storage -> Blob -> connect to the project. Optional in local dev:
# with no token, uploads fall back to the local filesystem.
BLOB_READ_WRITE_TOKEN=

# ─── GitHub (brief section 8) ──────────────────────────────────────────────
# Fine-grained PAT, public-repo read only. Server-side only, never exposed.
GITHUB_TOKEN=

# ─── Email alerts (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=
ALERT_EMAIL_TO=renoacollective@gmail.com

# ─── Spam protection (Cloudflare Turnstile) ────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Booking (Cal.com) ─────────────────────────────────────────────────────
NEXT_PUBLIC_CAL_LINK=
